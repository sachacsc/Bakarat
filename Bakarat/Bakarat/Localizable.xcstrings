    "Bakarat cares about **which tier** the winning hand falls into. That tier sets the multiplier." : {
      "comment" : "A description of how the tier of a winning hand affects the multiplier in Bakarat.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Bakarat, ce qui compte, c'est **la catégorie** de la main gagnante. Cette catégorie fixe le multiplicateur."
          }
        }
      }
    },
