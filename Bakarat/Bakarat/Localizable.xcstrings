      }
    },
    "Tap **Paid** on a debt to mark it settled. The other player sees it instantly. The game session greys out once everyone is squared up." : {
      "comment" : "A description of how to mark a debt as settled in the game.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
