    "Bilan : %@" : {
      "comment" : "A label that appears in the \"Historique\" section of the OnlineRootView, displaying the total balance of all games in the user's history. The argument is the string “0 %arg” or the string “%1$arg%2$arg %3$arg”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
